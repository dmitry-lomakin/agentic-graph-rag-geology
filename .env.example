# OpenAI (used for LLM calls only — embeddings are local)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LLM_MODEL=gpt-4o
OPENAI_LLM_MODEL_MINI=gpt-4o-mini
OPENAI_LLM_TEMPERATURE=0.0
# OPENAI_BASE_URL=http://localhost:4000/v1  # Uncomment for LiteLLM proxy

# Local Embedding Model (multilingual-e5-large for bilingual RU/EN corpus)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PREFIX_PASSAGE=passage:
EMBEDDING_PREFIX_QUERY=query:
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE=cuda  # Uncomment for GPU acceleration

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Indexing
INDEXING_CHUNK_SIZE=768
INDEXING_CHUNK_OVERLAP=100
INDEXING_SKELETON_BETA=0.25
INDEXING_KNN_K=10
INDEXING_PAGERANK_DAMPING=0.85

# Retrieval
RETRIEVAL_TOP_K_VECTOR=10
RETRIEVAL_TOP_K_FINAL=10
RETRIEVAL_VECTOR_THRESHOLD=0.5
RETRIEVAL_MAX_HOPS=3
RETRIEVAL_PPR_ALPHA=0.15

# Agent
AGENT_MAX_RETRIES=2
AGENT_RELEVANCE_THRESHOLD=2.0

# API (for Streamlit thin client)
# AGR_API_URL=http://localhost:8507  # Uncomment when running API server

# Logging
LOG_LEVEL=INFO
